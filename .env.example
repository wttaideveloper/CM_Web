# Invigorate Healthcare — frontend monorepo environment template
#
# Copy to `.env.local` (local dev) or configure in your deploy platform.
# NEVER commit real values. This file contains names + descriptions only.
#
# Apps: @ihp/shell (port 3000), @ihp/enterprise-admin (3001), @ihp/platform-admin (3002)

# --- Web Auth / Identity API -----------------------------------------------
# Backend that owns the /api/v1/auth/* and /api/v1/tenant/* rewrites.
# PRODUCTION: https://admin.apis.invigor8.app
# NOTE: the code default fallback is a STALE/DEAD AWS endpoint — always set this
# explicitly in every environment.
AUTH_API_BASE_URL=

# --- Workflow API (enterprise-admin only) ------------------------------------
# Rewrites /api/v1/forms, /api/v1/workflows, /api/v1/media. Required for workflow features.
WORKFLOW_API_BASE_URL=

# --- Platform / Marketplace data API (platform-admin + shared packages) ------
# Base for platform data APIs (products, services, attributes, enterprises, ...).
# Same-origin default is /api/v1 (proxied by next.config rewrites).
NEXT_PUBLIC_API_BASE_URL=

# --- Chat (packages/chat-runtime) --------------------------------------------
# Chat REST base URL. Two modes:
#   Legacy (current):    https://chat.wisdomtooth.tech/api/v1   (Bearer chat-token flow)
#   Gateway (Option A):  /chat-api                              (same-origin, cookie auth)
# Set /chat-api only AFTER the gateway route is deployed (see docs/gateway/CHAT_API_GATEWAY_SPEC.md).
NEXT_PUBLIC_CHAT_API_BASE_URL=

# Chat Socket.IO base. Keep the legacy host until the realtime migration (Phase 2).
NEXT_PUBLIC_CHAT_SOCKET_URL=

# --- Cross-app origins (auth redirects between the three Next apps) ----------
# Required in production so login/logout redirect correctly between apps.
# Local dev falls back to localhost:3000 / 3001 / 3002 automatically.
NEXT_PUBLIC_SHELL_ORIGIN=
NEXT_PUBLIC_ENTERPRISE_ADMIN_ORIGIN=
NEXT_PUBLIC_PLATFORM_ADMIN_ORIGIN=

# --- Dev/test only (do NOT set in production) --------------------------------
# Internal demo-auth upstream. Default http://13.207.85.164/api/v1.
# This backs the static/demo-user path; retire together with it once gateway auth is live.
MARKETPLACE_API_BASE_URL=