# Hostinger staging example for apps/platform-admin.
# Copy these non-secret values into the Platform Admin deployment environment;
# this file is not loaded automatically by Next.js.

NEXT_PUBLIC_SHELL_ORIGIN=https://marketplace.wisdomtoothstage.tech
NEXT_PUBLIC_ENTERPRISE_ADMIN_ORIGIN=https://marketplace-admin.wisdomtoothstage.tech
NEXT_PUBLIC_PLATFORM_ADMIN_ORIGIN=https://marketplace-platform.wisdomtoothstage.tech

# Platform Admin server-side Chat/Marketplace routes normalize this versioned base.
CHAT_API_BASE_URL=https://marketplace-api.wisdomtoothstage.tech/api/v1
PLATFORM_TRUSTED_UPSTREAM_ORIGINS=https://marketplace-api.wisdomtoothstage.tech

# No NEXT_PUBLIC_CHAT_* values are set here: no Platform Admin chat-runtime or
# Socket.IO browser consumer was identified in the audited code.

# Deferred: staging auth/workflow origins, cookie/CSRF settings and any independent
# Events service origin are not confirmed. Do not substitute production/local values.
# AUTH_API_BASE_URL=
# SUPER_ADMIN_AUTH_API_BASE_URL=
# EVENTS_API_BASE_URL=
# WORKFLOW_API_BASE_URL=
