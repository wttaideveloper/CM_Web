# Hostinger staging example for apps/shell.
# Copy these non-secret values into the Shell deployment environment; this file is not
# loaded automatically by Next.js. Keep authentication/workflow endpoints deferred
# until their staging origins and cookie contracts are confirmed.

NEXT_PUBLIC_SHELL_ORIGIN=https://marketplace.wisdomtoothstage.tech
NEXT_PUBLIC_ENTERPRISE_ADMIN_ORIGIN=https://marketplace-admin.wisdomtoothstage.tech
NEXT_PUBLIC_PLATFORM_ADMIN_ORIGIN=https://marketplace-platform.wisdomtoothstage.tech

# Confirmed API origin/base. The Shell currently supports direct Chat API access for
# this public client variable, so this preserves that contract for staging.
CHAT_API_BASE_URL=https://marketplace-api.wisdomtoothstage.tech/api/v1
NEXT_PUBLIC_API_BASE_URL=https://marketplace-api.wisdomtoothstage.tech/api/v1
NEXT_PUBLIC_CHAT_API_BASE_URL=https://marketplace-api.wisdomtoothstage.tech/api/v1
NEXT_PUBLIC_CHAT_SOCKET_URL=https://marketplace-api.wisdomtoothstage.tech
CHAT_PROXY_TARGET=https://marketplace-api.wisdomtoothstage.tech

# Deferred: do not infer or copy production/local values into staging.
# AUTH_API_BASE_URL=
# SUPER_ADMIN_AUTH_API_BASE_URL=
# EVENTS_API_BASE_URL=
# WORKFLOW_API_BASE_URL=
