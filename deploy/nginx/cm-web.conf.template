    listen 443 ssl; # managed by Certbot

    # Allow large upstream response headers (auth/complete-login etc.)
    proxy_buffer_size 32k;
    proxy_buffers 16 32k;
    ssl_certificate /etc/letsencrypt/live/chat.wisdomtooth.tech/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/chat.wisdomtooth.tech/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

