# Hostinger staging example for apps/enterprise-admin.
# Copy these non-secret values into the Enterprise Admin deployment environment;
# this file is not loaded automatically by Next.js.

NEXT_PUBLIC_SHELL_ORIGIN=https://marketplace.wisdomtoothstage.tech
NEXT_PUBLIC_ENTERPRISE_ADMIN_ORIGIN=https://marketplace-admin.wisdomtoothstage.tech
NEXT_PUBLIC_PLATFORM_ADMIN_ORIGIN=https://marketplace-platform.wisdomtoothstage.tech

# The Enterprise Admin BFF resolves both normal Chat routes and /auth/chat-token
# through CHAT_PROXY_TARGET. It adds /api/v1 exactly once. CHAT_API_BASE_URL is
# supplied with /api/v1 for server consumers that expect a versioned base. Browser
# Chat requests retain the existing same-origin /api/chat contract.
CHAT_PROXY_TARGET=https://marketplace-api.wisdomtoothstage.tech
CHAT_API_BASE_URL=https://marketplace-api.wisdomtoothstage.tech/api/v1
EVENTS_API_BASE_URL=https://marketplace-api.wisdomtoothstage.tech
NEXT_PUBLIC_CHAT_API_BASE_URL=/api/chat
NEXT_PUBLIC_CHAT_SOCKET_URL=https://marketplace-api.wisdomtoothstage.tech

# Deferred: staging auth/workflow origins and cookie/CSRF settings are not
# independently confirmed. Do not substitute production or local values here.
# AUTH_API_BASE_URL=
# SUPER_ADMIN_AUTH_API_BASE_URL=
# WORKFLOW_API_BASE_URL=
