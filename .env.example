# Invigorate Healthcare — frontend monorepo environment template
#
# Copy to `apps/<app>/.env.local` (local dev) or configure in your deploy platform.
# NEVER commit real values. This file contains names + descriptions only.
#
# Apps: @ihp/shell (port 3000), @ihp/enterprise-admin (3001), @ihp/platform-admin (3002)
#
# There are NO built-in default endpoints. A missing mandatory upstream variable fails `next build`
# (and container start-up) with the variable NAME, instead of silently talking to another backend.
# Docker/Hostinger deployment: see deploy/docker/frontend.env.example and docs/deployment/.

# --- Web Auth / Identity API -----------------------------------------------
# REQUIRED (all apps, build time). Backend that owns the /api/v1/auth/* and /api/v1/tenant/* rewrites.
AUTH_API_BASE_URL=
# REQUIRED (shell, platform-admin; runtime). Dedicated server-only upstream for Super Admin auth
# (shell login route + platform-admin super-admin-server-client).
SUPER_ADMIN_AUTH_API_BASE_URL=
# Optional (runtime). Cookie domain for the Super Admin refresh cookie; empty = host-only cookie.
SUPER_ADMIN_SESSION_COOKIE_DOMAIN=
# Optional (runtime, 1000-120000). Timeout for Super Admin upstream calls from platform-admin. Default 15000.
SUPER_ADMIN_UPSTREAM_TIMEOUT_MS=
EVENTS_API_BASE_URL=

# --- Marketplace API ----------------------------------------------------------
# REQUIRED (all apps, build time). Marketplace API base, e.g. https://api.example.com/api/v1.
# The scheme is used as given: https:// for public hosts; http:// is accepted ONLY for private/internal
# hosts (localhost, RFC 1918 addresses, single-label Docker service names).
CHAT_API_BASE_URL=
# Optional (shell, enterprise-admin; build time). Events API. Shell falls back to CHAT_API_BASE_URL;
# Enterprise Admin omits Event rewrites when unset.
EVENTS_API_BASE_URL=
# REQUIRED (shell, enterprise-admin; runtime). Marketplace API ORIGIN for the server-side chat and media proxies.
CHAT_PROXY_TARGET=
# Optional (enterprise-admin; runtime). Origin serving POST /auth/chat-token when it differs from CHAT_PROXY_TARGET.
CHAT_TOKEN_UPSTREAM_URL=

# --- Workflow API (enterprise-admin, platform-admin) --------------------------
# Rewrites /api/v1/forms, /api/v1/workflows, /api/v1/media. Workflow features are unavailable when unset.
WORKFLOW_API_BASE_URL=

# --- Platform Admin trusted upstreams -----------------------------------------
# REQUIRED (platform-admin; runtime). Comma-separated EXACT origins that may receive the server-held Super Admin
# bearer token: the Marketplace API origin AND, when WORKFLOW_API_BASE_URL is set, the Workflow API origin. Empty
# trusts nothing, so the Marketplace and Workflow proxy routes answer 503. An origin not listed here never gets the token.
PLATFORM_TRUSTED_UPSTREAM_ORIGINS=

# --- Browser API base ----------------------------------------------------------
# Leave unset for same-origin /api/v1 browser requests. Do not set this to an
# external backend URL; Next rewrites use server-only upstream variables instead.
NEXT_PUBLIC_API_BASE_URL=

# --- Chat (packages/chat-runtime) --------------------------------------------
# Chat REST base URL. Same-origin gateway: /api/chat (HttpOnly cookie forwarded server-side).
NEXT_PUBLIC_CHAT_API_BASE_URL=/api/chat

# Public Socket.IO origin the BROWSER connects to (path /api/socket.io). No default: realtime chat stays
# disabled when empty or invalid.
NEXT_PUBLIC_CHAT_SOCKET_URL=

# Public origin that appears inside backend-issued media URLs (browser-visible, not a secret). Event media is
# routed through the same-origin proxy only for URLs on this origin. The server fetches media from
# CHAT_PROXY_TARGET / CHAT_API_BASE_URL (which may be a different, internal origin).
NEXT_PUBLIC_PROTECTED_MEDIA_ORIGIN=

# --- Cross-app origins (auth redirects between the three Next apps) ----------
# Required in production so login/logout redirect correctly between apps.
# Local dev falls back to localhost:3000 / 3001 / 3002 automatically.
NEXT_PUBLIC_SHELL_ORIGIN=
NEXT_PUBLIC_ENTERPRISE_ADMIN_ORIGIN=
NEXT_PUBLIC_PLATFORM_ADMIN_ORIGIN=

# --- Security switches ----------------------------------------------------------
# "true" downgrades the Content-Security-Policy to report-only (rollout kill-switch). Default: enforced.
CSP_REPORT_ONLY=

# --- Dev/test only (do NOT set in production) --------------------------------
# LEGACY unauthenticated demo-token bridge used by Shell chat/realtime. OFF unless this is exactly "true".
# Its replacement is an open Identity-team decision (see docs/deployment/BLOCKERS.md).
MARKETPLACE_DEMO_AUTH_ENABLED=
# Marketplace API base (incl. /api/v1) used ONLY when the bridge above is enabled. No default host.
MARKETPLACE_API_BASE_URL=
