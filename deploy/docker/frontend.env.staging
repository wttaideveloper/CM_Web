# Staging variant of deploy/docker/frontend.env for the Hostinger frontend stack.
#
#   docker compose --env-file deploy/docker/frontend.env.staging -f deploy/docker/compose.frontend.yaml build
#   docker compose --env-file deploy/docker/frontend.env.staging -f deploy/docker/compose.frontend.yaml up -d
#
# Tracked in Git on purpose: every value here is a URL or origin, not a credential.
# Auth / Super Admin / Workflow endpoints are the EXISTING ones (unchanged).
# Group Chat realtime stays disabled (NEXT_PUBLIC_GROUP_CHAT_REALTIME_ENABLED is empty).

# ---------------------------------------------------------------------------------------------
# Marketplace API (existing backend containers on the classifieds-marketplace-internal network)
# ---------------------------------------------------------------------------------------------
CHAT_API_BASE_URL=http://classifieds-marketplace-api:8000/api/v1
CHAT_PROXY_TARGET=http://classifieds-marketplace-api:8000
EVENTS_API_BASE_URL=
CHAT_TOKEN_UPSTREAM_URL=

# ---------------------------------------------------------------------------------------------
# Identity / Super Admin / Workflow — existing endpoints, unchanged
# ---------------------------------------------------------------------------------------------
AUTH_API_BASE_URL=https://admin.apis.invigor8.app
SUPER_ADMIN_AUTH_API_BASE_URL=https://admin.apis.invigor8.app
SUPER_ADMIN_SESSION_COOKIE_DOMAIN=
WORKFLOW_API_BASE_URL=https://admin.apis.invigor8.app

# ---------------------------------------------------------------------------------------------
# Platform Admin trusted upstreams
# ---------------------------------------------------------------------------------------------
PLATFORM_TRUSTED_UPSTREAM_ORIGINS=http://classifieds-marketplace-api:8000

# ---------------------------------------------------------------------------------------------
# Browser-visible values (build-time, inlined into the client bundle)
# ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_CHAT_SOCKET_URL=https://marketplace-api.wisdomtoothstage.tech
NEXT_PUBLIC_PROTECTED_MEDIA_ORIGIN=
NEXT_PUBLIC_SHELL_ORIGIN=https://marketplace.wisdomtoothstage.tech
NEXT_PUBLIC_ENTERPRISE_ADMIN_ORIGIN=https://marketplace-admin.wisdomtoothstage.tech
NEXT_PUBLIC_PLATFORM_ADMIN_ORIGIN=https://marketplace-platform.wisdomtoothstage.tech
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CHAT_API_BASE_URL=/api/chat
NEXT_PUBLIC_GROUP_CHAT_REALTIME_ENABLED=
NEXT_PUBLIC_ASSET_PREFIX=

# ---------------------------------------------------------------------------------------------
# Security switches
# ---------------------------------------------------------------------------------------------
CSP_REPORT_ONLY=false
MARKETPLACE_DEMO_AUTH_ENABLED=false
MARKETPLACE_API_BASE_URL=
SUPER_ADMIN_UPSTREAM_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------------------------
# Image tags
# ---------------------------------------------------------------------------------------------
SHELL_IMAGE_TAG=hostinger-staging
ENTERPRISE_ADMIN_IMAGE_TAG=hostinger-staging
PLATFORM_ADMIN_IMAGE_TAG=hostinger-staging