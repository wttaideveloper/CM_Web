server {
    server_name chat.wisdomtooth.tech;

    # Swagger
    location /api/docs {
        proxy_pass http://127.0.0.1:8000/api/docs;
    }

    location /api/redoc {
        proxy_pass http://127.0.0.1:8000/api/redoc;
    }

    location /api/openapi.json {
        proxy_pass http://127.0.0.1:8000/api/openapi.json;
    }

    # Socket.IO
location /api/socket.io/ {
    proxy_pass http://127.0.0.1:8001/api/socket.io/;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_read_timeout 86400;
    proxy_send_timeout 86400;
}


# Shell app handled routes (Next.js on 3000) - must be BEFORE generic /api/
    location ^~ /api/v1/auth/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
