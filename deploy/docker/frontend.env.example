# Environment template for deploy/docker/compose.frontend.yaml (Hostinger staging).
#
#   cp deploy/docker/frontend.env.example deploy/docker/frontend.env     # on the server, never in Git
#
# This file lists variable NAMES with placeholder values only. Put real values in frontend.env, which is
# git-ignored. Do not place secrets (tokens, passwords, keys) in build-time variables: they are baked into
# image layers. Everything below is a URL or origin, not a credential.
#
# [build]   = baked into the image at `docker compose build` (Next.js rewrites / NEXT_PUBLIC_*)
# [runtime] = read when the container starts
# Variables marked REQUIRED make the build or the container refuse to start, by name, when missing.

# ---------------------------------------------------------------------------------------------
# Marketplace API (the existing backend containers on the classifieds-marketplace-internal network)
# ---------------------------------------------------------------------------------------------
# [build+runtime] REQUIRED. Marketplace API base including /api/v1 (internal HTTP is allowed for private hosts).
CHAT_API_BASE_URL=http://classifieds-marketplace-api:8000/api/v1
# [runtime] REQUIRED (shell, enterprise-admin). Marketplace API ORIGIN used by the server-side chat/media proxies.
CHAT_PROXY_TARGET=http://classifieds-marketplace-api:8000
# [build] Optional. Events API; CHAT_API_BASE_URL is used for the Shell when unset.
EVENTS_API_BASE_URL=
# [runtime] Optional (enterprise-admin). Set only if POST /auth/chat-token is served by a different origin than CHAT_PROXY_TARGET.
CHAT_TOKEN_UPSTREAM_URL=

# ---------------------------------------------------------------------------------------------
# Identity / Super Admin / Workflow — configured independently of the Marketplace API
# ---------------------------------------------------------------------------------------------
# [build+runtime] REQUIRED. Identity API serving /api/v1/auth and /api/v1/tenant.
AUTH_API_BASE_URL=https://identity.example.invalid
# [runtime] REQUIRED (shell, platform-admin). Dedicated Super Admin gateway.
SUPER_ADMIN_AUTH_API_BASE_URL=https://superadmin.example.invalid
# [runtime] Optional. Cookie domain for the Super Admin refresh cookie (leave empty for host-only cookies).
SUPER_ADMIN_SESSION_COOKIE_DOMAIN=
# [build+runtime] Optional (enterprise-admin, platform-admin). Workflow API; workflow features are unavailable when unset.
# Platform Admin additionally requires this origin to be listed in PLATFORM_TRUSTED_UPSTREAM_ORIGINS (see below).
WORKFLOW_API_BASE_URL=

# ---------------------------------------------------------------------------------------------
# Platform Admin trusted upstreams (replaces the former hard-coded chat.wisdomtooth.tech checks)
# ---------------------------------------------------------------------------------------------
# [runtime] REQUIRED (platform-admin). Comma-separated EXACT origins that may receive the Super Admin bearer
# token: the Marketplace API origin AND, when WORKFLOW_API_BASE_URL is set, the Workflow API origin (for example
# "http://classifieds-marketplace-api:8000,https://workflow.example.invalid"). An origin that is not listed here is
# never sent the token and its proxy routes answer 503. An empty value trusts nothing. Cleartext http:// is accepted
# only for private/internal hosts.
PLATFORM_TRUSTED_UPSTREAM_ORIGINS=http://classifieds-marketplace-api:8000

# ---------------------------------------------------------------------------------------------
# Browser-visible values ([build], inlined into the client bundle). Public origins only.
# They depend on the domain/Nginx/TLS decision that is still pending; unset values disable the
# related feature explicitly instead of falling back to another environment.
# ---------------------------------------------------------------------------------------------
# Public Socket.IO origin the BROWSER connects to (path is /api/socket.io). Realtime chat is disabled when empty.
NEXT_PUBLIC_CHAT_SOCKET_URL=
# Public origin that appears inside backend-issued media URLs. Media is not proxied when empty.
NEXT_PUBLIC_PROTECTED_MEDIA_ORIGIN=
# Public origins of the three apps (cross-app login redirects). Required before browser login works end to end.
NEXT_PUBLIC_SHELL_ORIGIN=
NEXT_PUBLIC_ENTERPRISE_ADMIN_ORIGIN=
NEXT_PUBLIC_PLATFORM_ADMIN_ORIGIN=
# Leave empty for same-origin /api/v1 requests (recommended).
NEXT_PUBLIC_API_BASE_URL=
# Same-origin chat gateway path.
NEXT_PUBLIC_CHAT_API_BASE_URL=/api/chat
# "true" enables Group Chat realtime for authenticated Enterprise users.
NEXT_PUBLIC_GROUP_CHAT_REALTIME_ENABLED=
# Optional CDN/asset prefix for platform-admin static files.
NEXT_PUBLIC_ASSET_PREFIX=

# ---------------------------------------------------------------------------------------------
# Security switches
# ---------------------------------------------------------------------------------------------
# [runtime] "true" downgrades the Content-Security-Policy to report-only (rollout kill-switch). Default: enforced.
CSP_REPORT_ONLY=false
# [runtime] LEGACY. "true" re-enables the unauthenticated demo-token bridge used by Shell chat.
# Default false. Do not enable without an Identity-team decision (see docs/deployment/BLOCKERS.md).
MARKETPLACE_DEMO_AUTH_ENABLED=false
# [runtime] Only read when the legacy bridge above is enabled. Marketplace API base including /api/v1.
MARKETPLACE_API_BASE_URL=
# [runtime] Optional upstream timeout (ms, 1000-120000) for Super Admin calls from platform-admin.
SUPER_ADMIN_UPSTREAM_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------------------------
# Image tags (each app is versioned and rolled back independently)
# ---------------------------------------------------------------------------------------------
SHELL_IMAGE_TAG=hostinger-staging
ENTERPRISE_ADMIN_IMAGE_TAG=hostinger-staging
PLATFORM_ADMIN_IMAGE_TAG=hostinger-staging
